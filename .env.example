# Publiczny adres aplikacji (Railway: domena serwisu). Używany w linkach e-mail i OAuth.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Tylko na serwerze (cron przypomnień, powiadomienia o anulowaniu). Nigdy nie z prefiksem NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Połączenie z bazą do migracji przy wdrożeniu (Railway preDeployCommand).
# Supabase → Connect → Session pooler (IPv4, port 5432). Hasło musi być zakodowane w URL.
# Puste = migracje pomijane.
SUPABASE_DB_URL=

# Daily.co → Developers → API key. Bez klucza pokój działa w trybie demonstracyjnym.
DAILY_API_KEY=

# Web Push: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:kontakt@twojadomena.pl

# Sekret wywołań /api/cron/tick (ten sam w supabase/cron.sql). np. openssl rand -hex 32
CRON_SECRET=
